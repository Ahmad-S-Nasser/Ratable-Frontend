{
  "name": "ratable-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:generate": "openapi-typescript http://localhost:5080/openapi/v1.json -o src/lib/api/schema.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mongodb": "^7.7.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
